{
  "manifest": "1",
  "id": "builtin.viewer.video.viewer",
  "version": "1",
  "kind": "registry",
  "title": "视频播放器",
  "description": "播放 mp4 / mkv / avi 等视频：播放暂停、进度、音量、倍速、循环、全屏、前 / 后一秒、首末帧、画面缩放、截图、内嵌字幕与音轨选择，可设为进入就自动播放。",
  "items": [
    {
      "key": "builtin.viewer.video",
      "name": "视频播放器",
      "kind": "viewer",
      "host": "dialog",
      "extensions": [
        "mp4",
        "m4v",
        "avi",
        "mkv",
        "mov",
        "wmv",
        "flv",
        "webm",
        "mpg",
        "mpeg",
        "rmvb",
        "3gp"
      ],
      "capabilities": [
        "播放暂停",
        "进度拖动",
        "音量",
        "倍速",
        "循环",
        "全屏",
        "前 / 后一秒",
        "首末帧",
        "画面缩放",
        "截图",
        "内嵌字幕",
        "音轨选择",
        "进入就播放"
      ],
      "description": "播放 mp4 / mkv / avi 等视频：播放暂停、进度、音量、倍速、循环、全屏、前 / 后一秒、首末帧、画面缩放、截图、内嵌字幕与音轨选择，可设为进入就自动播放。",
      "order": 100
    }
  ]
}
