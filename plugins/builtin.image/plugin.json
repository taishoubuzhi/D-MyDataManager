{
  "id": "builtin.image",
  "name": "内置图片查看器",
  "version": "1.0.0",
  "api_version": ">=1.0 <2.0",
  "description": "查看 png / jpg / gif 等图片，支持缩放、旋转与适应窗口。",
  "author": "D-MyDataManager",
  "builtin": true,
  "entry": "plugin.py",
  "depends": [
    {
      "id": "builtin.lib.viewer"
    },
    {
      "id": "builtin.lib.ui"
    }
  ],
  "data": {
    "viewer": "data/viewer.json"
  },
  "options": [
    {
      "key": "fit_on_open",
      "label": "打开时适应窗口",
      "kind": "bool",
      "default": true,
      "description": "打开图片时自动缩放到刚好填满窗口，小图也会放大；关闭后按原始大小显示。"
    },
    {
      "key": "zoom_step",
      "label": "缩放步长",
      "kind": "choice",
      "default": "1.25",
      "choices": {
        "1.1": "1.1×（细腻）",
        "1.25": "1.25×（默认）",
        "1.5": "1.5×（快速）"
      },
      "description": "点击放大 / 缩小按钮时每次的缩放倍数。"
    },
    {
      "key": "smooth_scaling",
      "label": "平滑缩放",
      "kind": "bool",
      "default": true,
      "description": "缩放时使用平滑插值；关闭后速度更快，但放大后更粗糙。"
    }
  ]
}
