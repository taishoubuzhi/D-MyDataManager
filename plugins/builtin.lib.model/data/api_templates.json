      "model": "gpt-6.1-sol",
      "api_key_ref": "openai",
      "capabilities": ["chat", "vision", "embedding"],
      "description": "OpenAI 官方接口，需要 api.openai.com 的 API Key。",
      "docs": "https://platform.openai.com/docs/models",
      "models": [
        {"id": "gpt-6.1-sol-pro", "name": "GPT-6.1 Sol Pro", "capabilities": ["chat", "vision"], "description": "旗舰，看图 + 长文档，最贵。"},
