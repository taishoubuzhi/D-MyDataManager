{
  "DB": {
    // 数据库连接信息
    "URL": "sqlite:///data.db",
    // 是否打印数据库操作
    "Echo": true,
    // 数据库连接池最大值
    "Max-Pool-Size": 256,
    // 数据库连接池最小值
    "Min-Pool-Size": 0,
    // 数据库连接池大小 0 表示不限制
    "Pool-Size": 10,
    // 数据库最大额外连接池最大值
    "Max-Max-Overflow": 256,
    // 数据库最大额外连接池最小值
    "Min-Max-Overflow": 0,
    // 数据库最大额外连接池大小 0 表示不限制
    "Max-Overflow": 20,
    // 数据库连接池回收时间最大值
    "Max-Pool-Recycle": 86400,
    // 数据库连接池回收时间最小值
    "Min-Pool-Recycle": 0,
    // 数据库连接池回收时间
    "Pool-Recycle": 3600,
    // 检测数据库连接是否可用
    "Pool-Pre-Ping": true,
    // 连接参数
    "Connect-Args": {},
  }
}