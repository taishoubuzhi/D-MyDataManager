{
  "Default": {
    "Log": {
      // 过滤日志等级:只显示过滤的日志等级,TRACE(5):追踪,Debug(10):调试,Info(20):信息,Success(25):成功,Warn(30):警告,Error(40):错误,CRITICAL(50):严重错误
      "Log-Level": "Debug",
      // 日志格式{time}:日志时间,{level}:日志等级,{message}:日志内容,{name}:模块名,{line}:代码行号,{process}:进程ID,{thread}:线程ID
      "Log-Format": "{time} | {level} | {message}",
      // 是否将日志格式化为 JSON
      "Format-To-JSON": false,
      // JSON 格式
      "JSON-Format": "{time:MMMM D, YYYY > HH:mm:ss!UTC} | {level} | {message}",
      // 是否将错误日志输出
      "Catch": true,
      // 是否将日志输出到控制台
      "Output-Console": true,
      // 记录放入队列
      "Enqueue": true,
      // 编码
      "Encoding": "utf-8",
      // 异常跟踪是否应该延伸到捕获错误的点之外
      "Backtrace" :  true,
      // 变量值是否应在异常跟踪中显示
      "Diagnose" : true
    },
    "File": {
      // 是否将日志输出到文件
      "Output-File": true,
      // 是否将不同级别的日志写入不同的文件
      "Different-Level-Files": true,
      // 日志路径
      "Log-Path": "logs",
      // 日志文件名
      "Trace-File": "trace.log",
      "Debug-File": "debug.log",
      "Info-File": "info.log",
      "Success-File": "success.log",
      "Warn-File": "warn.log",
      "Error-File": "error.log",
      "Critical-File": "critical.log"
      // 日志文件名
      "Log-File": "log.log",
      // 日志文件覆盖
      "File-Overwrite": true,
      //轮转模式，包括None(不轮转),Size(文件大小),Time(时间),Interval(时间间隔)
      "Rotate-Mode": "None",
      // 超过 10MB 自动切割新文件 "10MB"
      "Rotate-Size": 10,
      // 文件大小单位
      "Rotate-Size-Unit": "MB",
      // 每天 00:00 生成新文件
      "Rotate-Time": "00:00",
      // 每 1 小时生成新文件 "1 hour"
      "Rotate-Interval": 1,
      // 间隔时间单位
      "Rotate-Interval-Unit": "hour",
      // 保留 7 天的日志 "7 days"
      "Retention": 7,
      // 保留时间单位
      "Retention-Unit": "days",
      // 压缩方式，包括 None(不压缩), zip(zip 压缩)
      "File-Compress": "zip",
    },
  }
}