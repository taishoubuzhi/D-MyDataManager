{
  "Log": {
    // 过滤日志等级:只显示过滤的日志等级,
    "Log-Level": "Debug",
    // 日志格式{time}:日志时间,{level}:日志等级,{message}:日志内容,{name}:模块名,{line}:代码行号,{process}:进程ID,{thread}:线程ID
    "Log-Format": "{time} | {level} | {message}",
    // 是否将日志格式化为 JSON
    "Format-To-JSON": false,
    // JSON 格式
    "JSON-Format": "{time:MMMM D, YYYY > HH:mm:ss!UTC} | {level} | {message}",
    // 是否将错误日志输出
    "Catch": true,
    // 是否将日志输出到控制台
    "Output-Console": true,
    // 记录放入队列
    "Enqueue": true,
    // 默认编码
    "Encoding": "utf-8",
    // 异常跟踪是否应该延伸到捕获错误的点之外
    "Backtrace": true,
    // 变量值是否应在异常跟踪中显示
    "Diagnose": true
  },
  "File": {
    // 是否将日志输出到文件
    "Output-File": true,
    // 是否将不同级别的日志写入不同的文件
    "Different-Level-Files": true,
    // 日志路径
    "Log-Path": "logs",
    // 日志文件名
    "File-Trace": "trace.log",
    "File-Debug": "debug.log",
    "File-Info": "info.log",
    "File-Success": "success.log",
    "File-Warn": "warn.log",
    "File-Error": "error.log",
    "File-Critical": "critical.log",
    // 日志文件名
    "File-Log": "log.log",
    // 日志文件覆盖
    "File-Overwrite": true,
    // 默认轮转模式
    "Rotate-Mode": "None",
    // 超过 10MB 自动切割新文件 "10MB"
    "Rotate-Size": 10,
    // 默认文件大小单位
    "Rotate-Size-Unit": "MB",
    // 每天 00:00 生成新文件
    "Rotate-Time": "00:00",
    // 每 1 小时生成新文件 "1 hour"
    "Rotate-Interval": 1,
    // 默认间隔时间单位
    "Rotate-Interval-Unit": "hour",
    // 保留 7 天的日志 "7 days"
    "Retention": 7,
    // 默认保留时间单位
    "Retention-Unit": "days",
    // 默认压缩方式
    "Compress-Mode": "zip"
  }
}