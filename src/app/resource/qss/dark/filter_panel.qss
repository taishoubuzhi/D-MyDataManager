#filterPanel {
    background-color: transparent;
    border: none;
}

#filterHeader {
    background-color: rgba(255, 255, 255, 13);
    border: 1px solid rgb(46, 46, 46);
    border-radius: 6px;
}

#filterContent {
    background-color: rgba(255, 255, 255, 8);
    border: 1px solid rgb(46, 46, 46);
    border-top: none;
    border-radius: 0 0 6px 6px;
}
