DataCard {
    border: 1px solid rgb(220, 220, 220);
    border-radius: 10px;
    background-color: rgba(249, 249, 249, 0.95);
}

DataCard:hover {
    background-color: rgba(245, 245, 245, 0.98);
    border: 1px solid rgb(190, 190, 190);
}

DataCard[isSelected="true"] {
    border: 2px solid rgb(0, 120, 212);
    background-color: rgba(230, 243, 255, 0.98);
}

DataCard[isSelected="true"]:hover {
    background-color: rgba(220, 238, 255, 0.98);
}

#typeLabel, #contentLabel, #sizeLabel {
    color: rgb(90, 90, 90);
    font: 12px 'Segoe UI', 'Microsoft YaHei', 'PingFang SC';
}

DataListCard {
    border: 1px solid rgb(220, 220, 220);
    border-radius: 8px;
    background-color: rgba(249, 249, 249, 0.95);
}

DataListCard:hover {
    background-color: rgba(245, 245, 245, 0.98);
    border: 1px solid rgb(190, 190, 190);
}

#listTypeLabel, #listSizeLabel, #listContentLabel {
    color: rgb(90, 90, 90);
    font: 12px 'Segoe UI', 'Microsoft YaHei', 'PingFang SC';
}

#tagChip {
    border: 1px solid rgb(200, 200, 200);
    border-radius: 12px;
    background-color: rgba(230, 230, 230, 0.7);
}

#tagChip:hover {
    border: 1px solid rgb(170, 170, 170);
    background-color: rgba(215, 215, 215, 0.85);
}

#tagChipLabel {
    color: rgb(60, 60, 60);
    font: 11px 'Segoe UI', 'Microsoft YaHei', 'PingFang SC';
}

#tagContainer {
    background-color: transparent;
}
