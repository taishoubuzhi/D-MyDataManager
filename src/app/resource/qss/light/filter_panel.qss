#filterPanel {
    background-color: transparent;
    border: none;
}

#filterHeader {
    background-color: rgba(255, 255, 255, 200);
    border: 1px solid rgb(220, 220, 220);
    border-radius: 6px;
}

#filterContent {
    background-color: rgba(255, 255, 255, 180);
    border: 1px solid rgb(220, 220, 220);
    border-top: none;
    border-radius: 0 0 6px 6px;
}
